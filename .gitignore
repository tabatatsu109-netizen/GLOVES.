# ---------------------------------------------------------------------------
# 支給素材の原本（クライアント様の名前入りファイルを含む）
# Web用に軽量化したものは assets/images/ にあり、サイト表示はそちらだけを使う。
# 原本をリポジトリに含めると、静的ホスティング時に
#   https://ドメイン/アラセリオ様.png
# のように第三者が直接取得できてしまうため追跡しない。
# ---------------------------------------------------------------------------
/S__*.jpg
/zona.jpg
/*.png
/*.pdf

# ORIGINAL PRINT 商品写真の原本(仕入先カタログ画像)。
# 軽量化済みのものは assets/images/catalog/ にあり、サイト表示はそちらだけを使う。
/素材/

# カタログ生成スクリプト。仕入価格・掛け率が書かれているので公開リポジトリに含めない
# （生成物の assets/images/catalog/ と assets/js/print-catalog.js はコミットする）。
/tools/

# Claude Code のローカル設定（開発用）
/.claude/

# 開発用の一時ファイル（動作確認ハーネス）
/_verify.html
/_probe*.html

